---
const BUTTONDOWN_USERNAME = 'gavinwye';
const PAGE_URL = `https://buttondown.com/${BUTTONDOWN_USERNAME}`;
const ACTION_URL = `https://buttondown.email/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`;
---
<div class="newsletter-form-wrapper">
  <form
    id="newsletter-form"
    action={ACTION_URL}
    method="post"
    target="popupwindow"
    novalidate
  >
    <input type="hidden" name="embed" value="1" />
    <label for="email-input" class="sr-only">Email address</label>
    <div class="form-row">
      <input
        id="email-input"
        type="email"
        name="email"
        placeholder="your@email.com"
        required
        autocomplete="email"
      />
      <button type="submit">Stay in the loop</button>
    </div>
    <p id="form-success" class="form-message form-success" aria-live="polite" hidden>
      One more step: confirm in the window that just opened. Then check your email.
    </p>
  </form>
</div>

<style>
  .newsletter-form-wrapper {
    margin-top: 2rem;
    max-width: 32rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  input[type="email"] {
    flex: 1 1 14rem;
    min-height: 52px;
    padding: 12px 14px;
    border: 2px solid var(--charcoal);
    border-radius: 4px;
    background: var(--white);
    color: var(--charcoal);
    font-family: var(--font-body);
    font-size: 1.1rem;
  }

  input[type="email"]::placeholder {
    color: #6b6a68;
  }

  input[type="email"]:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 1px var(--ink);
  }

  button[type="submit"] {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 32px;
    background: var(--accent);
    color: var(--on-accent);
    border: 2px solid transparent;
    border-radius: 4px;
    font: 700 1.2rem/1 var(--font-head);
    cursor: pointer;
    transition: background-color 0.15s;
    white-space: nowrap;
  }

  button[type="submit"]:hover {
    background: color-mix(in srgb, var(--accent-text) 85%, #000);
    color: #fff;
  }

  button[type="submit"]:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 5px var(--ink);
  }

  button[type="submit"]:disabled {
    background: #e6e4df;
    color: #6b6a68;
    cursor: not-allowed;
  }

  .form-message {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0;
  }

  .form-success {
    color: var(--charcoal);
  }
</style>

<script define:vars={{ pageUrl: PAGE_URL }}>
  // Buttondown checks the visitor is human, so it has to be a real form post into
  // its own window. A background fetch gets the challenge page and a 400.
  const form = document.getElementById('newsletter-form');
  const successMsg = document.getElementById('form-success');

  form.addEventListener('submit', (e) => {
    if (!form.checkValidity()) {
      e.preventDefault();
      form.reportValidity();
      return;
    }
    window.open(pageUrl, 'popupwindow', 'scrollbars=yes,width=800,height=600');
    successMsg.hidden = false;
  });
</script>
