---
import NewsletterForm from './NewsletterForm.astro';
---
<section class="hero">
  <div class="hero__inner">
  <div class="hero__left">
    <div class="hero__left-content">
      <p class="hero__eyebrow eyebrow">Forthcoming book</p>
      <h1 class="hero__title">Leading<br />Robots</h1>
      <p class="hero__subtitle-book">The AI Organisation</p>
      <p class="hero__description">
        Your job is going to change. This is a guide for thinking through what that means for you, your skills, and the people you work with.
      </p>
      <NewsletterForm />
    </div>
  </div>
  <div class="hero__right">
    <div class="cover" role="img" aria-label="Book cover: Leading Robots, The AI Organisation (placeholder)">
      <p class="cover__title">Leading<br />Robots</p>
      <p class="cover__sub">The AI Organisation</p>
      <p class="cover__blurb">This is a guide for thinking through what that means for you, your skills, and the people you work with.</p>
      <div class="cover__gap"></div>
      <p class="cover__author">Gavin Wye</p>
    </div>
  </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    color: var(--charcoal);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: 1rem;
  }

  .hero__title {
    font-size: clamp(2.8rem, 9vw, 7rem);
    line-height: 1.02;
    margin-bottom: 0.5rem;
  }

  .hero__subtitle-book {
    font: 700 clamp(1.6rem, 4vw, 2.6rem)/1.05 var(--font-head);
    color: var(--accent-text);
    margin-bottom: 1.5rem;
  }

  .hero__description {
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    line-height: 1.35;
    color: var(--body-grey);
    max-width: 36ch;
    margin-bottom: 0;
  }

  .hero__right {
    display: flex;
    justify-content: center;
  }

  .cover {
    width: min(100%, 300px);
    aspect-ratio: 2 / 3;
    background: var(--accent);
    border-radius: 4px;
    box-shadow: inset 8px 0 0 rgba(0, 0, 0, 0.12), 0 24px 64px rgba(0, 0, 0, 0.18), 0 4px 16px rgba(0, 0, 0, 0.1);
    padding: 36px 28px 28px 36px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--ink);
  }

  .cover__title {
    font: 700 3.4rem/1 var(--font-head);
    color: var(--white);
    margin-bottom: 0.6rem;
  }

  .cover__sub {
    font: 700 1.5rem/1.05 var(--font-head);
    color: var(--ink);
    margin-bottom: 1.4rem;
  }

  .cover__blurb {
    font: 400 1rem/1.35 var(--font-body);
    color: var(--ink);
    margin: 0;
  }

  .cover__gap {
    flex: 1;
  }

  .cover__author {
    font: 600 1rem/1 var(--font-body);
    color: var(--ink);
    margin: 0;
  }

  @media (max-width: 760px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .cover {
      width: min(100%, 240px);
    }
  }
</style>
