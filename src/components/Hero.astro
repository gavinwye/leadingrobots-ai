---
import NewsletterForm from './NewsletterForm.astro';
---
<section class="hero">
  <div class="mesh" id="hero-mesh" aria-hidden="true"></div>
  <div class="hero__inner">
  <div class="hero__left">
    <div class="hero__left-content">
      <p class="hero__eyebrow eyebrow">Forthcoming book</p>
      <h1 class="hero__title">Leading<br />Robots</h1>
      <p class="hero__subtitle-book">The AI Organisation</p>
      <p class="hero__description">
        Your job is going to change. This is a guide for thinking through what that means — for you, your skills, and the people you work with.
      </p>
      <NewsletterForm />
    </div>
  </div>
  <div class="hero__right">
    <img
      src="/images/book-cover-placeholder.svg"
      alt="Leading Robots: The AI Organisation — book cover placeholder"
      class="hero__cover"
      width="300"
      height="450"
    />
  </div>
  </div>
</section>

<script is:inline>
  // brnd.gvn.sh gradient: one mesh per weekday in Europe/Paris, six accents top to bottom.
  (function () {
    var HEX = { sky: '#00a8ff', blue: '#2e3bff', violet: '#8300ff', purple: '#bc00ff', magenta: '#e600de', pink: '#ff08a1', red: '#ff3852', orange: '#ff5a19', amber: '#ff8300', yellow: '#ffc400' };
    var DAYS = {
      Monday: ['sky', 'blue', 'violet', 'purple', 'magenta', 'pink'],
      Tuesday: ['blue', 'violet', 'purple', 'magenta', 'pink', 'red'],
      Wednesday: ['violet', 'purple', 'magenta', 'pink', 'red', 'orange'],
      Thursday: ['purple', 'magenta', 'pink', 'red', 'orange', 'amber'],
      Friday: ['magenta', 'pink', 'red', 'orange', 'amber', 'yellow'],
      Saturday: ['sky', 'violet', 'magenta', 'red', 'amber', 'yellow'],
      Sunday: ['pink', 'magenta', 'purple', 'violet', 'blue', 'sky']
    };
    var host = document.getElementById('hero-mesh');
    if (!host) return;
    var day = new Intl.DateTimeFormat('en-GB', { weekday: 'long', timeZone: 'Europe/Paris' }).format(new Date());
    var P = (DAYS[day] || DAYS.Monday).map(function (n) { return HEX[n]; });
    function layer(rev) {
      var C = rev ? P.slice().reverse() : P, parts = [];
      for (var i = 0; i < 16; i++) {
        var y = 2 + 96 * i / 15;
        var ci = Math.max(0, Math.min(5, Math.round(y / 100 * 5 + (i % 2 ? 0.6 : -0.6))));
        var x = i % 2 ? 82 : 18 + (i % 3) * 12;
        parts.push('radial-gradient(ellipse 62% 7.5% at ' + x + '% ' + y.toFixed(1) + '%, ' + C[ci] + ' 0%, transparent 100%)');
      }
      parts.push('linear-gradient(to bottom, ' + C.join(', ') + ')');
      return parts.join(', ');
    }
    var tint = document.createElement('div'); tint.className = 'tint';
    var a = document.createElement('i'), b = document.createElement('i'); b.className = 'b';
    a.style.backgroundImage = layer(false); b.style.backgroundImage = layer(true);
    tint.appendChild(a); tint.appendChild(b); host.appendChild(tint);
  })();
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--paper);
    color: var(--charcoal);
  }

  /* Day mesh: 30% strength over paper, text on it is always charcoal. */
  .mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--paper);
  }
  .mesh :global(.tint) { position: absolute; inset: 0; opacity: 0.3; }
  .mesh :global(i) { position: absolute; inset: -6%; display: block; }
  .mesh :global(.b) { opacity: 0; animation: swap 5s ease-in-out infinite alternate; }
  @keyframes swap {
    from { opacity: 0; transform: translateY(0); }
    to { opacity: 1; transform: translateY(-1.5%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mesh :global(.b) { animation: none; opacity: 0; }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: 1rem;
  }

  .hero__title {
    font-size: clamp(2.8rem, 9vw, 7rem);
    line-height: 1.02;
    margin-bottom: 0.5rem;
  }

  .hero__subtitle-book {
    font: 700 clamp(1.6rem, 4vw, 2.6rem)/1.05 var(--font-head);
    color: var(--accent-text);
    margin-bottom: 1.5rem;
  }

  .hero__description {
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    line-height: 1.35;
    color: var(--body-grey);
    max-width: 36ch;
    margin-bottom: 0;
  }

  .hero__right {
    display: flex;
    justify-content: center;
  }

  .hero__cover {
    max-height: 50vh;
    width: auto;
    border-radius: 4px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.18), 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 760px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero__cover {
      max-height: 60vw;
    }
  }
</style>
