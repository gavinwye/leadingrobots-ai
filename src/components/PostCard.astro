---
interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
}

const { title, date, description, slug } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---
<article class="post-card">
  <time class="post-card__date" datetime={date.toISOString().slice(0, 10)}>
    {formattedDate}
  </time>
  <h2 class="post-card__title">
    <a href={`/thinking-out-loud/${slug}`}>{title}</a>
  </h2>
  <p class="post-card__description">{description}</p>
</article>

<style>
  .post-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 28px;
  }

  .post-card__date {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--body-grey);
    margin-bottom: 0.5rem;
  }

  .post-card__title {
    font-size: 1.75rem;
    margin-bottom: 0.6rem;
  }

  .post-card__title a {
    color: var(--charcoal);
    text-decoration: none;
  }

  .post-card__title a:hover {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .post-card__description {
    font-size: 1.1rem;
    color: var(--body-grey);
    margin: 0;
  }
</style>
