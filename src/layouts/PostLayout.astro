---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
}

const { title, description, date, tags } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---
<BaseLayout title={title} description={description}>
  <div class="post-wrapper">
    <a href="/thinking-out-loud" class="post-back">&larr; Thinking Out Loud</a>

    <header class="post-header">
      <h1 class="post-header__title">{title}</h1>
      <time class="post-header__date" datetime={date.toISOString().slice(0, 10)}>
        {formattedDate}
      </time>
      {tags.length > 0 && (
        <ul class="post-header__tags">
          {tags.map(tag => <li>{tag}</li>)}
        </ul>
      )}
    </header>

    <article class="post-body">
      <slot />
    </article>

    <a href="/thinking-out-loud" class="post-back post-back--bottom">&larr; Thinking Out Loud</a>
  </div>
</BaseLayout>

<style>
  .post-wrapper {
    max-width: calc(var(--reading-width) + 2 * var(--gutter));
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) var(--gutter);
  }

  .post-back {
    display: inline-block;
    font: 700 1.1rem/1 var(--font-head);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }

  .post-back--bottom {
    margin-top: 3.5rem;
    margin-bottom: 0;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--charcoal);
  }

  .post-header__title {
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    margin-bottom: 1rem;
  }

  .post-header__date {
    display: block;
    font-weight: 500;
    color: var(--body-grey);
  }

  .post-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }

  .post-header__tags li {
    font: 600 0.7rem/1 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.6rem;
    background: #ebe9e4;
    border-radius: 2px;
    color: var(--body-grey);
  }

  .post-body {
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .post-body :global(p) {
    margin-bottom: 1.2em;
    max-width: var(--reading-width);
  }

  .post-body :global(h2) {
    font-size: 2.2rem;
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .post-body :global(h3) {
    font-size: 1.6rem;
    margin-top: 1.8em;
    margin-bottom: 0.5em;
  }

  .post-body :global(blockquote) {
    border-left: 4px solid var(--accent);
    margin: 2em 0;
    padding: 0.25em 1.5em;
    color: var(--body-grey);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.3em;
    margin-bottom: 1.2em;
  }

  .post-body :global(li) {
    margin-bottom: 0.4em;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.5em 0;
  }
</style>
